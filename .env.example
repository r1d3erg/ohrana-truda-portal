# Скопируйте в .env и задайте свои значения (файл .env в git не попадает)
POSTGRES_DB=ohrana
POSTGRES_USER=ohrana
POSTGRES_PASSWORD=change-me

# Необязательные настройки бэкенда
MAX_UPLOAD_MB=10
READINESS_GOOD=90
READINESS_WARN=70

# --- Авторизация (docs/auth.md) ---
# Первый администратор создаётся при первом запуске, если пользователей ещё нет.
# Без ADMIN_PASSWORD пароль сгенерируется и будет выведен в лог бэкенда (docker compose logs backend).
# При первом входе пароль в любом случае нужно сменить.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
# true — если портал открывается по HTTPS (cookie сессии только по HTTPS)
COOKIE_SECURE=false
SESSION_HOURS=12
SESSION_IDLE_MIN=120
# Swagger UI на /api/docs (в продакшене лучше false)
API_DOCS=false
